// toml: the TOML subset Eider manifests and lockfiles use. Pure Eider, no capabilities.
//
// Supported: comments, `[a]` / `[a.b]` headers, `[[a]]` array-of-tables headers, bare and
// quoted keys, dotted keys, basic strings (\n \t \r \" \\ escapes), integers, booleans,
// arrays of strings (may span lines), and inline tables `{ k = v, ... }`.
// The document is flattened: every value gets its full dotted key, and the n-th `[[a]]`
// table (from 0) is the key prefix `a.<n>`.

import "../../std/bytes.ei"

pub type Val = | Str(s: List[u8]) | Int(n: i64) | Bool(b: bool) | Strs(items: List[List[u8]])

pub type Entry = { key: List[u8], val: Val, line: u32 }

pub type ParseError = { line: u32, col: u32, msg: String }

type P = { src: List[u8], i: usize, line: u32, col: u32 }

type Count = { name: List[u8], n: u64 }

fn fail(p: P, m: str) -> ParseError { ParseError(p.line, p.col, String.from(m)) }

fn peek(p: P) -> u8 {
    if p.i < p.src.len() { return p.src[p.i] }
    0
}

fn at_end(p: P) -> bool { p.i >= p.src.len() }

fn bump(inout p: P) {
    if p.i < p.src.len() {
        if p.src[p.i] == 10 {
            p.line += 1
            p.col = 1
        } else {
            p.col += 1
        }
        p.i += 1
    }
}

/// Spaces and tabs.
fn blank(inout p: P) {
    while peek(p) == 32 || peek(p) == 9 { bump(inout p) }
}

/// Blanks, newlines and comments.
fn space(inout p: P) {
    while !at_end(p) {
        let c = peek(p)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            bump(inout p)
        } else if c == 35 {
            while !at_end(p) && peek(p) != 10 { bump(inout p) }
        } else {
            return
        }
    }
}

/// Blanks, an optional comment, then a newline or the end of the input.
fn end_line(inout p: P) -> Result[bool, ParseError] {
    blank(inout p)
    if peek(p) == 35 {
        while !at_end(p) && peek(p) != 10 { bump(inout p) }
    }
    if peek(p) == 13 { bump(inout p) }
    if at_end(p) { return Ok(true) }
    if peek(p) != 10 { return Err(fail(p, "expected the end of the line")) }
    bump(inout p)
    Ok(true)
}

fn is_bare(c: u8) -> bool { bytes.is_ident(c) || c == 45 }

/// "..." with the opening quote at the cursor.
fn string(inout p: P) -> Result[List[u8], ParseError] {
    bump(inout p)
    var out: List[u8] = List.new()
    while true {
        if at_end(p) || peek(p) == 10 { return Err(fail(p, "unterminated string")) }
        let c = peek(p)
        if c == 34 {
            bump(inout p)
            return Ok(out)
        }
        if c == 92 {
            bump(inout p)
            let e = peek(p)
            if e == 110 {
                out.push(10)
            } else if e == 116 {
                out.push(9)
            } else if e == 114 {
                out.push(13)
            } else if e == 34 || e == 92 {
                out.push(e)
            } else {
                return Err(fail(p, "unsupported escape (use \\n \\t \\r \\\" or \\\\)"))
            }
            bump(inout p)
        } else {
            out.push(c)
            bump(inout p)
        }
    }
    Ok(out)
}

/// One key segment: bare or quoted.
fn key_part(inout p: P) -> Result[List[u8], ParseError] {
    if peek(p) == 34 { return string(inout p) }
    var out: List[u8] = List.new()
    while is_bare(peek(p)) {
        out.push(peek(p))
        bump(inout p)
    }
    if out.len() == 0 { return Err(fail(p, "expected a key")) }
    Ok(out)
}

/// a.b."c d" -> `a.b.c d`
fn key(inout p: P) -> Result[List[u8], ParseError] {
    var k = key_part(inout p)?
    blank(inout p)
    while peek(p) == 46 {
        bump(inout p)
        blank(inout p)
        let part = key_part(inout p)?
        k.push(46)
        bytes.append(inout k, part)
        blank(inout p)
    }
    Ok(k)
}

fn join_key(prefix: List[u8], k: List[u8]) -> List[u8] {
    if prefix.len() == 0 { return k }
    var out = prefix
    out.push(46)
    bytes.append(inout out, k)
    out
}

fn add(inout out: List[Entry], k: List[u8], v: Val, line: u32) -> Result[bool, ParseError] {
    for e in out {
        if bytes.eq(e.key, k) { return Err(ParseError(line, 1, String.from("duplicate key"))) }
    }
    out.push(Entry(k, v, line))
    Ok(true)
}

fn integer(inout p: P) -> Result[i64, ParseError] {
    var neg = false
    if peek(p) == 45 || peek(p) == 43 {
        neg = peek(p) == 45
        bump(inout p)
    }
    var digits: List[u8] = List.new()
    while bytes.is_digit(peek(p)) || peek(p) == 95 {
        if peek(p) != 95 { digits.push(peek(p)) }
        bump(inout p)
    }
    match bytes.parse_u64(digits) {
        Some(v) => {
            if v > 9223372036854775807 { return Err(fail(p, "integer out of range")) }
            let n = v as i64
            if neg { return Ok(0 - n) }
            Ok(n)
        }
        None => {
            if digits.len() > 0 { return Err(fail(p, "integer out of range")) }
            Err(fail(p, "expected a value (string, integer, true/false, array or inline table)"))
        }
    }
}

/// [ "a", "b", ] (strings only; may span lines and hold comments)
fn array(inout p: P) -> Result[List[List[u8]], ParseError] {
    bump(inout p)
    var items: List[List[u8]] = List.new()
    while true {
        space(inout p)
        if peek(p) == 93 {
            bump(inout p)
            return Ok(items)
        }
        if peek(p) != 34 { return Err(fail(p, "arrays may only hold strings here")) }
        let s = string(inout p)?
        items.push(s)
        space(inout p)
        if peek(p) == 44 {
            bump(inout p)
        } else if peek(p) != 93 {
            return Err(fail(p, "expected `,` or `]`"))
        }
    }
    Ok(items)
}

/// Parse the value for key `k` (already prefixed); inline tables add several entries.
fn value(inout p: P, k: List[u8], inout out: List[Entry]) -> Result[bool, ParseError] {
    let line = p.line
    let c = peek(p)
    if c == 34 {
        let s = string(inout p)?
        return add(inout out, k, Str(s), line)
    }
    if c == 91 {
        let items = array(inout p)?
        return add(inout out, k, Strs(items), line)
    }
    if c == 123 {
        bump(inout p)
        blank(inout p)
        if peek(p) == 125 {
            bump(inout p)
            return Ok(true)
        }
        while true {
            blank(inout p)
            let sub = key(inout p)?
            if peek(p) != 61 { return Err(fail(p, "expected `=`")) }
            bump(inout p)
            blank(inout p)
            value(inout p, join_key(k, sub), inout out)?
            blank(inout p)
            if peek(p) == 125 {
                bump(inout p)
                return Ok(true)
            }
            if peek(p) != 44 { return Err(fail(p, "expected `,` or `}`")) }
            bump(inout p)
        }
    }
    if c == 116 || c == 102 {
        var word: List[u8] = List.new()
        while bytes.is_alpha(peek(p)) {
            word.push(peek(p))
            bump(inout p)
        }
        if word.len() == 4 && word[0] == 116 && word[1] == 114 && word[2] == 117 && word[3] == 101 {
            return add(inout out, k, Bool(true), line)
        }
        if word.len() == 5 && word[0] == 102 && word[1] == 97 && word[2] == 108 && word[3] == 115 && word[4] == 101 {
            return add(inout out, k, Bool(false), line)
        }
        return Err(ParseError(line, p.col, String.from("expected `true` or `false`")))
    }
    let n = integer(inout p)?
    add(inout out, k, Int(n), line)
}

/// Bump and return the next index for `[[name]]`.
fn next_index(inout counts: List[Count], name: List[u8]) -> u64 {
    for i in 0..counts.len() {
        if bytes.eq(counts[i].name, name) {
            let n = counts[i].n
            counts[i] = Count(name, n + 1)
            return n
        }
    }
    counts.push(Count(name, 1))
    0
}

pub fn parse(src: List[u8]) -> Result[List[Entry], ParseError] {
    var p = P(src, 0, 1, 1)
    var out: List[Entry] = List.new()
    var prefix: List[u8] = List.new()
    var counts: List[Count] = List.new()
    while true {
        space(inout p)
        if at_end(p) { return Ok(out) }
        if peek(p) == 91 {
            bump(inout p)
            let is_array = peek(p) == 91
            if is_array { bump(inout p) }
            blank(inout p)
            let name = key(inout p)?
            if peek(p) != 93 { return Err(fail(p, "expected `]`")) }
            bump(inout p)
            if is_array {
                if peek(p) != 93 { return Err(fail(p, "expected `]]`")) }
                bump(inout p)
                let n = next_index(inout counts, name)
                prefix = join_key(name, bytes.from_u64(n))
            } else {
                prefix = name
            }
            end_line(inout p)?
        } else {
            let k = key(inout p)?
            if peek(p) != 61 { return Err(fail(p, "expected `=` after the key")) }
            bump(inout p)
            blank(inout p)
            value(inout p, join_key(prefix, k), inout out)?
            end_line(inout p)?
        }
    }
    Ok(out)
}

// ---- lookups

pub fn get(doc: List[Entry], k: List[u8]) -> Option[Entry] {
    for e in doc {
        if bytes.eq(e.key, k) { return Some(e) }
    }
    None
}

/// Distinct next segments of keys under `prefix.` (e.g. dependency names under `deps`).
pub fn children(doc: List[Entry], prefix: List[u8]) -> List[List[u8]] {
    var want = prefix
    want.push(46)
    var out: List[List[u8]] = List.new()
    for e in doc {
        if bytes.starts_with(e.key, want) {
            let rest = bytes.slice(e.key, want.len(), e.key.len())
            let seg = match bytes.find_byte(rest, 46, 0) {
                Some(i) => bytes.slice(rest, 0, i)
                None => rest
            }
            var seen = false
            for o in out {
                if bytes.eq(o, seg) { seen = true }
            }
            if !seen { out.push(seg) }
        }
    }
    out
}

/// A basic string, quoted and escaped for output.
pub fn quote(s: List[u8]) -> List[u8] {
    var out: List[u8] = List.new()
    out.push(34)
    for c in s {
        if c == 34 || c == 92 {
            out.push(92)
            out.push(c)
        } else if c == 10 {
            out.push(92)
            out.push(110)
        } else if c == 9 {
            out.push(92)
            out.push(116)
        } else if c == 13 {
            out.push(92)
            out.push(114)
        } else {
            out.push(c)
        }
    }
    out.push(34)
    out
}
