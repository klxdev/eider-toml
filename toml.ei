//! toml: TOML for Eider. Pure Eider, no capabilities.
//!
//! Two APIs:
//!
//! - Typed values: this package is the TOML format for `std/serial` (eider-lang #100, #167). A
//!   type with `@[derive(Serialize, Deserialize)]`, or your own impls, goes to TOML with
//!   `to_string(x)` / `to_bytes(x)` and comes back with `from_string(s)` / `from_bytes(src)`;
//!   the type to read is the expected one: `let r: Result[Config, serial.Error] =
//!   toml.from_string(text)`. `@[serial(...)]` shapes the mapping for every format and
//!   `@[toml(...)]` (`name`, `skip`, `default`, `rename_all`, `tag`, `unknown`) for this one.
//!   The whole of TOML 1.0 is read (`toml.doc`: tables, arrays of tables, dotted keys, every
//!   string form, floats, date-times, inline tables). A record is a table, a list an array
//!   (a list of records is written as `[[array of tables]]`), an absent option is left out, bytes
//!   are a base64 string, a time is a TOML date-time, a variant without fields is its name and
//!   one with fields a sub-table under its name (or, with `tag`, a table that has the tag).
//!   Reading is strict like JSON's: a key no field takes is an error unless
//!   `@[toml(unknown = "ignore")]`, and every error names its place (`servers[1].port`).
//!   TOML has no null: an absent option inside a list cannot be written (an error), and the top
//!   level must be a table.
//! - The flattened subset eider-pkg reads (`eider.toml`, `eider.lock`): `parse` flattens a
//!   document into `Entry` values keyed by their full dotted key (the n-th `[[a]]` table is the
//!   prefix `a.<n>`), with source lines; `get`, `children` and `quote` work on that. It holds
//!   comments, `[a]` / `[a.b]` headers, `[[a]]` arrays of tables, bare, quoted and dotted keys,
//!   basic strings (\n \t \r \" \\ escapes), integers, booleans, arrays of strings (may span
//!   lines), and inline tables `{ k = v, ... }`.

import std.bytes
import std.encoding
import std.serial
import std.time
import toml.doc

pub type Val = | Str(s: List[u8]) | Int(n: i64) | Bool(b: bool) | Strs(items: List[List[u8]])

pub type Entry = { key: List[u8], val: Val, line: u32 }

pub type ParseError = { line: u32, col: u32, msg: String }

type P = { src: List[u8], i: usize, line: u32, col: u32 }

type Count = { name: List[u8], n: u64 }

fn fail(p: P, m: str) -> ParseError { ParseError(p.line, p.col, String.from(m)) }

fn peek(p: P) -> u8 {
    if p.i < p.src.len() { return p.src[p.i] }
    0
}

fn at_end(p: P) -> bool { p.i >= p.src.len() }

fn bump(inout p: P) {
    if p.i < p.src.len() {
        if p.src[p.i] == 10 {
            p.line += 1
            p.col = 1
        } else {
            p.col += 1
        }
        p.i += 1
    }
}

/// Spaces and tabs.
fn blank(inout p: P) {
    while peek(p) == 32 || peek(p) == 9 { bump(inout p) }
}

/// Blanks, newlines and comments.
fn space(inout p: P) {
    while !at_end(p) {
        let c = peek(p)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            bump(inout p)
        } else if c == 35 {
            while !at_end(p) && peek(p) != 10 { bump(inout p) }
        } else {
            return
        }
    }
}

/// Blanks, an optional comment, then a newline or the end of the input.
fn end_line(inout p: P) -> Result[bool, ParseError] {
    blank(inout p)
    if peek(p) == 35 {
        while !at_end(p) && peek(p) != 10 { bump(inout p) }
    }
    if peek(p) == 13 { bump(inout p) }
    if at_end(p) { return Ok(true) }
    if peek(p) != 10 { return Err(fail(p, "expected the end of the line")) }
    bump(inout p)
    Ok(true)
}

fn is_bare(c: u8) -> bool { bytes.is_ident(c) || c == 45 }

/// "..." with the opening quote at the cursor.
fn string(inout p: P) -> Result[List[u8], ParseError] {
    bump(inout p)
    let mut out: List[u8] = List.new()
    while true {
        if at_end(p) || peek(p) == 10 { return Err(fail(p, "unterminated string")) }
        let c = peek(p)
        if c == 34 {
            bump(inout p)
            return Ok(out)
        }
        if c == 92 {
            bump(inout p)
            let e = peek(p)
            if e == 110 {
                out.push(10)
            } else if e == 116 {
                out.push(9)
            } else if e == 114 {
                out.push(13)
            } else if e == 34 || e == 92 {
                out.push(e)
            } else {
                return Err(fail(p, "unsupported escape (use \\n \\t \\r \\\" or \\\\)"))
            }
            bump(inout p)
        } else {
            out.push(c)
            bump(inout p)
        }
    }
    Ok(out)
}

/// One key segment: bare or quoted.
fn key_part(inout p: P) -> Result[List[u8], ParseError] {
    if peek(p) == 34 { return string(inout p) }
    let mut out: List[u8] = List.new()
    while is_bare(peek(p)) {
        out.push(peek(p))
        bump(inout p)
    }
    if out.len() == 0 { return Err(fail(p, "expected a key")) }
    Ok(out)
}

/// a.b."c d" -> `a.b.c d`
fn key(inout p: P) -> Result[List[u8], ParseError] {
    let mut k = key_part(inout p)?
    blank(inout p)
    while peek(p) == 46 {
        bump(inout p)
        blank(inout p)
        let part = key_part(inout p)?
        k.push(46)
        bytes.append(inout k, part)
        blank(inout p)
    }
    Ok(k)
}

fn join_key(prefix: List[u8], k: List[u8]) -> List[u8] {
    if prefix.len() == 0 { return k }
    let mut out = prefix.copy()
    out.push(46)
    bytes.append(inout out, k)
    out
}

fn add(inout out: List[Entry], k: List[u8], v: Val, line: u32) -> Result[bool, ParseError] {
    for e in out {
        if bytes.eq(e.key, k) { return Err(ParseError(line, 1, String.from("duplicate key"))) }
    }
    out.push(Entry(k, v, line))
    Ok(true)
}

fn integer(inout p: P) -> Result[i64, ParseError] {
    let mut neg = false
    if peek(p) == 45 || peek(p) == 43 {
        neg = peek(p) == 45
        bump(inout p)
    }
    let mut digits: List[u8] = List.new()
    while bytes.is_digit(peek(p)) || peek(p) == 95 {
        if peek(p) != 95 { digits.push(peek(p)) }
        bump(inout p)
    }
    match bytes.parse_u64(digits) {
        Some(v) => {
            if v > 9223372036854775807 { return Err(fail(p, "integer out of range")) }
            let n = v as i64
            if neg { return Ok(0 - n) }
            Ok(n)
        }
        None => {
            if digits.len() > 0 { return Err(fail(p, "integer out of range")) }
            Err(fail(p, "expected a value (string, integer, true/false, array or inline table)"))
        }
    }
}

/// [ "a", "b", ] (strings only; may span lines and hold comments)
fn array(inout p: P) -> Result[List[List[u8]], ParseError] {
    bump(inout p)
    let mut items: List[List[u8]] = List.new()
    while true {
        space(inout p)
        if peek(p) == 93 {
            bump(inout p)
            return Ok(items)
        }
        if peek(p) != 34 { return Err(fail(p, "arrays may only hold strings here")) }
        let s = string(inout p)?
        items.push(s)
        space(inout p)
        if peek(p) == 44 {
            bump(inout p)
        } else if peek(p) != 93 {
            return Err(fail(p, "expected `,` or `]`"))
        }
    }
    Ok(items)
}

/// Parse the value for key `k` (already prefixed); inline tables add several entries.
fn value(inout p: P, k: List[u8], inout out: List[Entry]) -> Result[bool, ParseError] {
    let line = p.line.copy()
    let c = peek(p)
    if c == 34 {
        let s = string(inout p)?
        return add(inout out, k, Str(s), line)
    }
    if c == 91 {
        let items = array(inout p)?
        return add(inout out, k, Strs(items), line)
    }
    if c == 123 {
        bump(inout p)
        blank(inout p)
        if peek(p) == 125 {
            bump(inout p)
            return Ok(true)
        }
        while true {
            blank(inout p)
            let sub = key(inout p)?
            if peek(p) != 61 { return Err(fail(p, "expected `=`")) }
            bump(inout p)
            blank(inout p)
            value(inout p, join_key(k, sub), inout out)?
            blank(inout p)
            if peek(p) == 125 {
                bump(inout p)
                return Ok(true)
            }
            if peek(p) != 44 { return Err(fail(p, r"expected `,` or `}`")) }
            bump(inout p)
        }
    }
    if c == 116 || c == 102 {
        let mut word: List[u8] = List.new()
        while bytes.is_alpha(peek(p)) {
            word.push(peek(p))
            bump(inout p)
        }
        if word.len() == 4 && word[0] == 116 && word[1] == 114 && word[2] == 117 && word[3] == 101 {
            return add(inout out, k, Bool(true), line)
        }
        if word.len() == 5 && word[0] == 102 && word[1] == 97 && word[2] == 108 && word[3] == 115 && word[4] == 101 {
            return add(inout out, k, Bool(false), line)
        }
        return Err(ParseError(line, p.col, String.from("expected `true` or `false`")))
    }
    let n = integer(inout p)?
    add(inout out, k, Int(n), line)
}

/// Bump and return the next index for `[[name]]`.
fn next_index(inout counts: List[Count], name: List[u8]) -> u64 {
    for i in 0..counts.len() {
        if bytes.eq(counts[i].name, name) {
            let n = counts[i].n.copy()
            counts[i] = Count(name, n + 1)
            return n
        }
    }
    counts.push(Count(name, 1))
    0
}

pub fn parse(src: List[u8]) -> Result[List[Entry], ParseError] {
    let mut p = P(src, 0, 1, 1)
    let mut out: List[Entry] = List.new()
    let mut prefix: List[u8] = List.new()
    let mut counts: List[Count] = List.new()
    while true {
        space(inout p)
        if at_end(p) { return Ok(out) }
        if peek(p) == 91 {
            bump(inout p)
            let is_array = peek(p) == 91
            if is_array { bump(inout p) }
            blank(inout p)
            let name = key(inout p)?
            if peek(p) != 93 { return Err(fail(p, "expected `]`")) }
            bump(inout p)
            if is_array {
                if peek(p) != 93 { return Err(fail(p, "expected `]]`")) }
                bump(inout p)
                let n = next_index(inout counts, name)
                prefix = join_key(name, bytes.from_u64(n))
            } else {
                prefix = name
            }
            end_line(inout p)?
        } else {
            let k = key(inout p)?
            if peek(p) != 61 { return Err(fail(p, "expected `=` after the key")) }
            bump(inout p)
            blank(inout p)
            value(inout p, join_key(prefix, k), inout out)?
            end_line(inout p)?
        }
    }
    Ok(out)
}

// ---- lookups

pub fn get(doc: List[Entry], k: List[u8]) -> Option[Entry] {
    for e in doc {
        if bytes.eq(e.key, k) { return Some(e) }
    }
    None
}

/// Distinct next segments of keys under `prefix.` (e.g. dependency names under `deps`).
pub fn children(doc: List[Entry], prefix: List[u8]) -> List[List[u8]] {
    let mut want = prefix.copy()
    want.push(46)
    let mut out: List[List[u8]] = List.new()
    for e in doc {
        if bytes.starts_with(e.key, want) {
            let rest = bytes.slice(e.key, want.len(), e.key.len())
            let seg = match bytes.find_byte(rest, 46, 0) {
                Some(i) => bytes.slice(rest, 0, i)
                None => rest
            }
            let mut seen = false
            for o in out {
                if bytes.eq(o, seg) { seen = true }
            }
            if !seen { out.push(seg) }
        }
    }
    out
}

/// A basic string, quoted and escaped for output.
pub fn quote(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    out.push(34)
    for c in s {
        if c == 34 || c == 92 {
            out.push(92)
            out.push(c)
        } else if c == 10 {
            out.push(92)
            out.push(110)
        } else if c == 9 {
            out.push(92)
            out.push(116)
        } else if c == 13 {
            out.push(92)
            out.push(114)
        } else {
            out.push(c)
        }
    }
    out.push(34)
    out
}

// ---- typed values: the format for std/serial

/// A TOML writer for `serial.Serialize` (`to_bytes`, `to_string`): the format named "toml". The
/// events build a `serial.Value` (a TOML document cannot be written in event order: a table's
/// plain keys come before its sub-tables), which `to_bytes` renders.
pub type Serializer = { v: serial.ValueSerializer }

pub fn serializer() -> Serializer { Serializer(serial.ValueSerializer(List.new(), None, false)) }

impl serial.Serializer for Serializer {
    fn format(self) -> str { "toml" }
    fn bool(inout self, v: bool) -> Result[(), serial.Error] { self.v.bool(v) }
    fn int(inout self, v: i64) -> Result[(), serial.Error] { self.v.int(v) }
    fn uint(inout self, v: u64) -> Result[(), serial.Error] {
        if v > 9223372036854775807 { return Err(serial.error("TOML integers are 64-bit signed: the number is too large")) }
        self.v.uint(v)
    }
    fn float(inout self, v: f64) -> Result[(), serial.Error] { self.v.float(v) }
    fn string(inout self, v: List[u8]) -> Result[(), serial.Error] { self.v.string(v) }
    fn bytes(inout self, v: List[u8]) -> Result[(), serial.Error] { self.v.bytes(v) }
    fn time(inout self, v: time.DateTime) -> Result[(), serial.Error] { self.v.time(v) }
    fn none(inout self) -> Result[(), serial.Error] { self.v.none() }
    fn begin_list(inout self, len: usize) -> Result[(), serial.Error] { self.v.begin_list(len) }
    fn end_list(inout self) -> Result[(), serial.Error] { self.v.end_list() }
    fn begin_map(inout self, len: usize) -> Result[(), serial.Error] { self.v.begin_map(len) }
    fn key(inout self, k: List[u8]) -> Result[(), serial.Error] { self.v.key(k) }
    fn end_map(inout self) -> Result[(), serial.Error] { self.v.end_map() }
    fn begin_record(inout self, len: usize) -> Result[(), serial.Error] { self.v.begin_record(len) }
    fn field(inout self, name: List[u8]) -> Result[(), serial.Error] { self.v.field(name) }
    fn end_record(inout self) -> Result[(), serial.Error] { self.v.end_record() }
    fn begin_variant(inout self, name: List[u8], tag: List[u8], len: usize) -> Result[(), serial.Error] { self.v.begin_variant(name, tag, len) }
    fn end_variant(inout self) -> Result[(), serial.Error] { self.v.end_variant() }
    fn merge_next(inout self) -> Result[(), serial.Error] { self.v.merge_next() }
}

fn is_bare_key(k: List[u8]) -> bool {
    if k.len() == 0 { return false }
    for c in k {
        if !(bytes.is_ident(c) || c == 45) { return false }
    }
    true
}

fn key_text(k: List[u8]) -> List[u8] {
    if is_bare_key(k) { return k }
    quote_full(k)
}

/// A basic string with every control character escaped.
fn quote_full(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    out.push(34)
    for c in s {
        if c == 34 || c == 92 {
            out.push(92)
            out.push(c)
        } else if c == 10 {
            bytes.append(inout out, r"\n".bytes())
        } else if c == 9 {
            bytes.append(inout out, r"\t".bytes())
        } else if c == 13 {
            bytes.append(inout out, r"\r".bytes())
        } else if c < 32 || c == 127 {
            bytes.append(inout out, r"\u00".bytes())
            out.push(hex_nibble(c / 16))
            out.push(hex_nibble(c % 16))
        } else {
            out.push(c)
        }
    }
    out.push(34)
    out
}

fn hex_nibble(n: u8) -> u8 {
    if n < 10 { return 48 + n }
    87 + n
}

fn float_text(v: f64) -> List[u8] {
    if v != v { return "nan".bytes() }
    if v - v != 0.0 {
        if v < 0.0 { return "-inf".bytes() }
        return "inf".bytes()
    }
    let mut t = v.to_string().bytes()
    // a float must not look like an integer
    let mut plain = true
    for c in t {
        if c == 46 || c == 101 || c == 69 { plain = false }
    }
    if plain { bytes.append(inout t, ".0".bytes()) }
    t
}

fn is_null(v: serial.Value) -> bool {
    match v {
        serial.VNull => true
        _ => false
    }
}

fn is_map(v: serial.Value) -> bool {
    match v {
        serial.VMap(_) => true
        _ => false
    }
}

/// A non-empty list whose elements are all tables: written as `[[a.b]]` sections.
fn is_tables(v: serial.Value) -> bool {
    match v {
        serial.VList(xs) => {
            if xs.len() == 0 { return false }
            for x in xs {
                if !is_map(x) { return false }
            }
            true
        }
        _ => false
    }
}

/// A value written inline: scalars, arrays and inline tables.
fn inline(inout out: List[u8], v: serial.Value) -> Result[(), serial.Error] {
    match v {
        serial.VNull => Err(serial.error("TOML has no null: an absent option cannot be written inside a list"))
        serial.VBool(b) => {
            let word = if b { "true".bytes() } else { "false".bytes() }
            bytes.append(inout out, word)
            Ok(())
        }
        serial.VInt(n) => {
            bytes.append(inout out, bytes.from_i64(n))
            Ok(())
        }
        serial.VUint(u) => {
            bytes.append(inout out, bytes.from_u64(u))
            Ok(())
        }
        serial.VFloat(f) => {
            bytes.append(inout out, float_text(f))
            Ok(())
        }
        serial.VStr(s) => {
            bytes.append(inout out, quote_full(s))
            Ok(())
        }
        serial.VBytes(b) => {
            bytes.append(inout out, quote_full(encoding.base64(b).bytes()))
            Ok(())
        }
        serial.VTime(t) => {
            bytes.append(inout out, t.rfc3339().bytes())
            Ok(())
        }
        serial.VList(xs) => {
            out.push(91)
            for i in 0..xs.len() {
                if i > 0 { bytes.append(inout out, ", ".bytes()) }
                inline(inout out, xs[i].copy())?
            }
            out.push(93)
            Ok(())
        }
        serial.VMap(es) => {
            out.push(123)
            let mut first = true
            for e in es {
                if is_null(e.value) { continue }
                if !first { bytes.append(inout out, ", ".bytes()) }
                first = false
                bytes.append(inout out, key_text(e.key))
                bytes.append(inout out, " = ".bytes())
                inline(inout out, e.value.copy())?
            }
            out.push(125)
            Ok(())
        }
    }
}

fn dotted(path: List[List[u8]]) -> List[u8] {
    let mut parts: List[List[u8]] = List.new()
    for k in path { parts.push(key_text(k)) }
    bytes.join(parts, ".".bytes())
}

/// The members of a table: plain `key = value` lines first, then its sub-tables.
fn table_body(inout out: List[u8], path: List[List[u8]], es: List[serial.Entry]) -> Result[(), serial.Error] {
    for e in es {
        if is_null(e.value) || is_map(e.value) || is_tables(e.value) { continue }
        bytes.append(inout out, key_text(e.key))
        bytes.append(inout out, " = ".bytes())
        match inline(inout out, e.value.copy()) {
            Ok(_) => {}
            Err(err) => {
                let mut where_ = path.copy()
                where_.push(e.key.copy())
                return Err(serial.error_at(dotted(where_), err.msg))
            }
        }
        out.push(10)
    }
    for e in es {
        let mut sub = path.copy()
        sub.push(e.key.copy())
        match e.value {
            serial.VMap(inner) => {
                if out.len() > 0 { out.push(10) }
                out.push(91)
                bytes.append(inout out, dotted(sub))
                bytes.append(inout out, "]\n".bytes())
                table_body(inout out, sub, inner)?
            }
            serial.VList(xs) => {
                if is_tables(e.value) {
                    for x in xs {
                        match x {
                            serial.VMap(inner) => {
                                if out.len() > 0 { out.push(10) }
                                bytes.append(inout out, "[[".bytes())
                                bytes.append(inout out, dotted(sub))
                                bytes.append(inout out, "]]\n".bytes())
                                table_body(inout out, sub, inner)?
                            }
                            _ => {}
                        }
                    }
                }
            }
            _ => {}
        }
    }
    Ok(())
}

/// The TOML text of a table value.
fn render(v: serial.Value) -> Result[List[u8], serial.Error] {
    match v {
        serial.VMap(es) => {
            let mut out: List[u8] = List.new()
            table_body(inout out, List.new(), es)?
            Ok(out)
        }
        _ => Err(serial.error("a TOML document is a table: write a record or a map at the top"))
    }
}

/// `x` as TOML text. `x` must be a record, a map or an enum with fields.
pub fn to_bytes[T: serial.Serialize](x: T) -> Result[List[u8], serial.Error] {
    let mut s = serializer()
    x.serialize(inout s)?
    match s.v.out {
        Some(v) => render(v)
        None => Err(serial.error("nothing was written"))
    }
}

/// `x` as TOML text, as a `String`.
pub fn to_string[T: serial.Serialize](x: T) -> Result[String, serial.Error] {
    let b = to_bytes(x)?
    match String.from_bytes(b) {
        Ok(s) => Ok(s)
        Err(_) => Err(serial.error("the text has a NUL character"))
    }
}

/// The value of type T in the TOML text `src`, parsed within `doc.limits()` (8 MiB).
pub fn from_bytes[T: serial.Deserialize](src: List[u8]) -> Result[T, serial.Error] { from_bytes_with(src, doc.limits()) }

/// The value of type T in the TOML text `s`.
pub fn from_string[T: serial.Deserialize](s: String) -> Result[T, serial.Error] { from_bytes(s.bytes()) }

pub fn from_bytes_with[T: serial.Deserialize](src: List[u8], lim: doc.Limits) -> Result[T, serial.Error] {
    let d = match doc.parse_with(src, lim) {
        Ok(x) => x
        Err(e) => { return Err(serial.error_at(List.new(), doc.error_text(e))) }
    }
    T.deserialize(doc.deserializer(d, d.root))
}
